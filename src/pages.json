{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/tabBar/schedule",
      "style": {
        "navigationBarTitleText": "日程"
      }
    },
    {
      "path": "pages/tabBar/task",
      "style": {
        "navigationBarTitleText": "打卡"
      }
    },
    {
      "path": "pages/tabBar/more",
      "style": {
        "navigationBarTitleText": "更多"
      }
    },
    {
      "path": "pages/tabBar/profile",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/profile/group-manage",
      "style": {
        "navigationBarTitleText": "群组管理",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/profile/share",
      "style": {
        "navigationBarTitleText": "邀请",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/schedule/edit",
      "style": {
        "navigationBarTitleText": "编辑日程",
        "navigationBarBackgroundColor": "#ffffff",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/task/edit",
      "style": {
        "navigationBarTitleText": "编辑任务",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/schedule/share",
      "style": {
        "navigationBarTitleText": "日程分享",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/task/share",
      "style": {
        "navigationBarTitleText": "任务分享",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/task/calendar",
      "style": {
        "navigationBarTitleText": "任务日历",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/task/checkin-calendar",
      "style": {
        "navigationBarTitleText": "打卡日历",
        "enablePullDownRefresh": false
      }
    }
  ],
  "subPackages": [
    {
      "root": "subPackages/points",
      "pages": [
        {
          "path": "pages/points-product-manage",
          "style": {
            "navigationBarTitleText": "积分兑换管理",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/points-product-edit",
          "style": {
            "navigationBarTitleText": "积分兑换品编辑",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/points-exchange",
          "style": {
            "navigationBarTitleText": "积分兑换",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/points-exchange-records",
          "style": {
            "navigationBarTitleText": "兑换记录",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subPackages/study-tools",
      // ← 子包根路径
      "pages": [
        {
          "path": "pages/writing/stroke-order",
          // ← 页面路径（相对于 root）
          "style": {
            "navigationBarTitleText": "笔顺学习"
          }
        },
        {
          "path": "pages/writing/pinyin-converter",
          "style": {
            "navigationBarTitleText": "拼音",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/ledger/index",
          "style": {
            "navigationBarTitleText": "家庭账本",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "pages/ledger/edit",
          "style": {
            "navigationBarTitleText": "编辑流水",
            "enablePullDownRefresh": false
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/tabBar/more": {
      "network": "all",
      "packages": [
        "subPackages/study-tools"
      ]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "funfun日程",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#409EFF",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/tabBar/schedule",
        "text": "日程",
        "iconPath": "static/icons/schedule.png",
        "selectedIconPath": "static/icons/scheduleHL.png",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      },
      {
        "pagePath": "pages/tabBar/task",
        "text": "打卡",
        "iconPath": "static/icons/task.png",
        "selectedIconPath": "static/icons/taskHL.png",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      },
      {
        "pagePath": "pages/tabBar/more",
        "text": "更多",
        "iconPath": "static/icons/more.png",
        "selectedIconPath": "static/icons/moreHL.png"
      },
      {
        "pagePath": "pages/tabBar/profile",
        "text": "我的",
        "iconPath": "static/icons/my.png",
        "selectedIconPath": "static/icons/myHL.png"
      }
    ]
  }
}
