<view class="card">
  <view class="header">
    <text class="title">{{title}}</text>
    <text class="meta">最近 30 天</text>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="num">{{currentStreak}}</text>
      <text class="label">连续天数</text>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <text class="num">{{monthCheckinDays}}</text>
      <text class="label">本月打卡</text>
    </view>
  </view>

  <view class="grid">
    <view
      wx:for="{{grid}}"
      wx:key="date"
      class="cell {{item.done ? 'done' : 'miss'}}"
    ></view>
  </view>

  <view class="footer" bindtap="openCheckinPage">打开小程序看完整日历 ›</view>
</view>
