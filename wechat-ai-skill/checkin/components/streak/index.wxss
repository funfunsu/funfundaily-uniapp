.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  color: #222;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
}
.meta {
  font-size: 22rpx;
  color: #888;
}
.stats {
  display: flex;
  align-items: center;
  margin: 24rpx 0 20rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4a8cff;
}
.label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.cell {
  width: 38rpx;
  height: 38rpx;
  border-radius: 6rpx;
}
.cell.done {
  background: #4a8cff;
}
.cell.miss {
  background: #eef0f4;
}
.footer {
  margin-top: 18rpx;
  text-align: right;
  color: #4a8cff;
  font-size: 24rpx;
}
