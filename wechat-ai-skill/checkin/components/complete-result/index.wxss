.card {
  background: linear-gradient(135deg, #e8f7ec 0%, #fff 60%);
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  color: #222;
}
.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #4caf50;
  color: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.date {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}
.stats {
  display: flex;
  align-items: center;
  margin: 24rpx 0 12rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4caf50;
}
.label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}
.remaining {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}
.remaining-title {
  font-size: 26rpx;
  color: #666;
}
.remaining-row {
  font-size: 26rpx;
  color: #444;
  padding: 6rpx 0;
}
.all-done {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
  font-size: 26rpx;
  color: #4caf50;
}
.footer {
  margin-top: 18rpx;
  text-align: right;
  color: #4a8cff;
  font-size: 24rpx;
}
